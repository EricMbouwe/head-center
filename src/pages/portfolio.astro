---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('portfolio', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured === b.data.featured) {
    return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  }

  return a.data.featured ? -1 : 1;
});
---

<BaseLayout title="Head Center — Portfolio" description="Découvrez nos études de cas et projets marquants.">
  <section class="mx-auto max-w-6xl px-6 py-24 sm:px-12">
    <div class="mb-12 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Portfolio</p>
      <h1 class="mt-4 text-4xl font-heading text-white">Une sélection de projets impactants</h1>
      <p class="mt-4 text-base text-slate-300">
        Chaque collaboration est guidée par une obsession : délivrer rapidement un produit performant et mesurable.
      </p>
    </div>
    <div class="space-y-8">
      {projects.map((project) => (
        <article class={`rounded-3xl border border-white/5 bg-white/5 p-10 shadow-card ${project.data.featured ? 'ring-2 ring-cyanAura/60' : ''}`}>
          <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-indigoGlow">
            <span class="rounded-full bg-indigoGlow/20 px-3 py-1">{project.data.industry}</span>
            {project.data.techStack.map((tech) => (
              <span class="rounded-full bg-white/10 px-3 py-1 text-white">{tech}</span>
            ))}
          </div>
          <h2 class="mt-5 text-3xl font-heading text-white">{project.data.client}</h2>
          <p class="mt-4 text-base text-slate-300">{project.data.excerpt}</p>
          <div class="mt-5 flex flex-wrap gap-3 text-xs text-slate-300">
            {project.data.services.map((service) => (
              <span class="rounded-full border border-white/10 px-3 py-1">{service}</span>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap gap-4 text-sm">
            <a class="text-indigoGlow hover:text-cyanAura" href={project.data.documentationUrl} target="_blank" rel="noreferrer">Documentation</a>
            <a class="text-indigoGlow hover:text-cyanAura" href={project.data.demoUrl} target="_blank" rel="noreferrer">Env. de test</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
