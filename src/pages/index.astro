---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const latestPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1))
  .slice(0, 3);
---

<BaseLayout title="Head Center — Agence Web Moderne" description="Conception et développement de sites web professionnels en Astro, React et Tailwind.">
  <Hero client:load ctaHref="#contact" />

  <section id="portfolio" class="relative mx-auto max-w-6xl px-6 pb-24 sm:px-12 lg:px-24">
    <div class="mb-12 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Portfolio</p>
        <h2 class="mt-3 text-3xl font-heading text-white sm:text-4xl">Études de cas récentes</h2>
      </div>
      <a class="text-sm font-semibold text-indigoGlow hover:text-cyanAura transition" href="/portfolio">Voir tout</a>
    </div>
    <div class="grid gap-8 lg:grid-cols-3">
      <article class="rounded-3xl border border-white/5 bg-white/5 p-8 shadow-card backdrop-blur">
        <h3 class="text-2xl font-semibold text-white">NeoFit — Plateforme SaaS</h3>
        <p class="mt-3 text-sm text-slate-300">Déploiement multi-régions avec Supabase, Astro et React. Score Lighthouse 98+.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-slate-200">
          <span class="rounded-full bg-indigoGlow/20 px-3 py-1 text-indigoGlow">Astro</span>
          <span class="rounded-full bg-cyanAura/20 px-3 py-1 text-cyanAura">Supabase</span>
          <span class="rounded-full bg-white/10 px-3 py-1">Terraform</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <a class="text-indigoGlow hover:text-cyanAura" href="https://docs.example.com/neofit" target="_blank">Documentation</a>
          <a class="text-indigoGlow hover:text-cyanAura" href="https://demo.example.com/neofit" target="_blank">Env. de test</a>
        </div>
      </article>
      <article class="rounded-3xl border border-white/5 bg-white/5 p-8 shadow-card backdrop-blur">
        <h3 class="text-2xl font-semibold text-white">OrbitPay — Fintech</h3>
        <p class="mt-3 text-sm text-slate-300">Architecture micro-frontends, intégration CI/CD et observabilité avancée.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-slate-200">
          <span class="rounded-full bg-indigoGlow/20 px-3 py-1 text-indigoGlow">React</span>
          <span class="rounded-full bg-cyanAura/20 px-3 py-1 text-cyanAura">Kubernetes</span>
          <span class="rounded-full bg-white/10 px-3 py-1">Grafana</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <a class="text-indigoGlow hover:text-cyanAura" href="https://docs.example.com/orbitpay" target="_blank">Documentation</a>
          <a class="text-indigoGlow hover:text-cyanAura" href="https://demo.example.com/orbitpay" target="_blank">Env. de test</a>
        </div>
      </article>
      <article class="rounded-3xl border border-white/5 bg-white/5 p-8 shadow-card backdrop-blur">
        <h3 class="text-2xl font-semibold text-white">PulseCare — HealthTech</h3>
        <p class="mt-3 text-sm text-slate-300">Performance optimisée, conformité RGPD et pipelines GitHub Actions.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-slate-200">
          <span class="rounded-full bg-indigoGlow/20 px-3 py-1 text-indigoGlow">TypeScript</span>
          <span class="rounded-full bg-cyanAura/20 px-3 py-1 text-cyanAura">AWS</span>
          <span class="rounded-full bg-white/10 px-3 py-1">OpenTelemetry</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <a class="text-indigoGlow hover:text-cyanAura" href="https://docs.example.com/pulsecare" target="_blank">Documentation</a>
          <a class="text-indigoGlow hover:text-cyanAura" href="https://demo.example.com/pulsecare" target="_blank">Env. de test</a>
        </div>
      </article>
    </div>
  </section>

  <section id="blog" class="mx-auto max-w-6xl px-6 pb-24 sm:px-12 lg:px-24">
    <div class="mb-12 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Blog</p>
        <h2 class="mt-3 text-3xl font-heading text-white sm:text-4xl">Derniers articles</h2>
      </div>
      <a class="text-sm font-semibold text-indigoGlow hover:text-cyanAura transition" href="/blog">Lire le blog</a>
    </div>
    <div class="grid gap-6 lg:grid-cols-3">
      {latestPosts.map((post) => (
        <article class="group flex h-full flex-col justify-between rounded-3xl border border-white/5 bg-white/5 p-8 shadow-card transition hover:-translate-y-1 hover:bg-white/10">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-indigoGlow">{post.data.category}</p>
            <h3 class="mt-4 text-2xl font-semibold text-white">{post.data.title}</h3>
            <p class="mt-4 text-sm text-slate-300">{post.data.description}</p>
          </div>
          <div class="mt-6 flex items-center justify-between text-sm text-slate-300">
            <span>{new Date(post.data.publishedAt).toLocaleDateString('fr-FR')}</span>
            <a class="text-indigoGlow group-hover:text-cyanAura" href={`/blog/${post.slug}`}>Lire l’article</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="relative overflow-hidden border-t border-white/5 bg-white/5 py-24">
    <div class="absolute inset-0 -z-10 bg-hero opacity-40" />
    <div class="mx-auto max-w-4xl px-6 sm:px-12 lg:px-24">
      <h2 class="text-3xl font-heading text-white sm:text-4xl">Parlons de votre prochain projet</h2>
      <p class="mt-4 text-base text-slate-300">
        Nous bâtissons des produits digitaux durables, scalables et mesurables. Laissez-nous un message pour décrocher un audit gratuit.
      </p>
      <form class="mt-10 grid gap-6 md:grid-cols-2">
        <input class="rounded-2xl border border-white/10 bg-midnight/60 p-4 text-sm text-white placeholder:text-slate-500 focus:border-cyanAura focus:outline-none" placeholder="Nom" />
        <input class="rounded-2xl border border-white/10 bg-midnight/60 p-4 text-sm text-white placeholder:text-slate-500 focus:border-cyanAura focus:outline-none" placeholder="Email professionnel" />
        <input class="md:col-span-2 rounded-2xl border border-white/10 bg-midnight/60 p-4 text-sm text-white placeholder:text-slate-500 focus:border-cyanAura focus:outline-none" placeholder="Société" />
        <textarea class="md:col-span-2 min-h-[160px] rounded-2xl border border-white/10 bg-midnight/60 p-4 text-sm text-white placeholder:text-slate-500 focus:border-cyanAura focus:outline-none" placeholder="Parlez-nous de votre projet" />
        <button class="md:col-span-2 inline-flex items-center justify-center rounded-full bg-indigoGlow px-8 py-3 text-base font-semibold text-white shadow-card transition hover:bg-indigo-500" type="submit">
          Envoyer ma demande
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
