---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero';
import { getCollection } from 'astro:content';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Badge from '@components/ui/Badge.astro';
import Input from '@components/ui/Input.astro';
import Textarea from '@components/ui/Textarea.astro';

const posts = await getCollection('blog');
const latestPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1))
  .slice(0, 3);
---

<BaseLayout title="Head Center — Agence Web Moderne" description="Conception et développement de sites web professionnels en Astro, React et Tailwind.">
  <Hero client:load ctaHref="#contact" />

  <section id="portfolio" class="relative mx-auto max-w-6xl px-6 pb-24 sm:px-12 lg:px-24">
    <div class="mb-12 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Portfolio</p>
        <h2 class="mt-3 text-3xl font-heading text-white sm:text-4xl">Études de cas récentes</h2>
      </div>
      <Button href="/portfolio" variant="ghost" size="sm">Voir tout</Button>
    </div>
    <div class="grid gap-8 lg:grid-cols-3">
      <Card interactive padding="lg" class="h-full">
        <h3 class="text-2xl font-semibold text-white">NeoFit — Plateforme SaaS</h3>
        <p class="mt-3 text-sm text-slate-300">Déploiement multi-régions avec Supabase, Astro et React. Score Lighthouse 98+.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-slate-200">
          <Badge variant="accent">Astro</Badge>
          <Badge variant="info">Supabase</Badge>
          <Badge variant="outline">Terraform</Badge>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <Button href="https://docs.example.com/neofit" target="_blank" rel="noreferrer" variant="ghost" size="sm">
            Documentation
          </Button>
          <Button href="https://demo.example.com/neofit" target="_blank" rel="noreferrer" variant="ghost" size="sm">
            Env. de test
          </Button>
        </div>
      </Card>
      <Card interactive padding="lg" class="h-full">
        <h3 class="text-2xl font-semibold text-white">OrbitPay — Fintech</h3>
        <p class="mt-3 text-sm text-slate-300">Architecture micro-frontends, intégration CI/CD et observabilité avancée.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-slate-200">
          <Badge variant="accent">React</Badge>
          <Badge variant="info">Kubernetes</Badge>
          <Badge variant="outline">Grafana</Badge>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <Button href="https://docs.example.com/orbitpay" target="_blank" rel="noreferrer" variant="ghost" size="sm">
            Documentation
          </Button>
          <Button href="https://demo.example.com/orbitpay" target="_blank" rel="noreferrer" variant="ghost" size="sm">
            Env. de test
          </Button>
        </div>
      </Card>
      <Card interactive padding="lg" class="h-full">
        <h3 class="text-2xl font-semibold text-white">PulseCare — HealthTech</h3>
        <p class="mt-3 text-sm text-slate-300">Performance optimisée, conformité RGPD et pipelines GitHub Actions.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-slate-200">
          <Badge variant="accent">TypeScript</Badge>
          <Badge variant="info">AWS</Badge>
          <Badge variant="outline">OpenTelemetry</Badge>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <Button href="https://docs.example.com/pulsecare" target="_blank" rel="noreferrer" variant="ghost" size="sm">
            Documentation
          </Button>
          <Button href="https://demo.example.com/pulsecare" target="_blank" rel="noreferrer" variant="ghost" size="sm">
            Env. de test
          </Button>
        </div>
      </Card>
    </div>
  </section>

  <section id="blog" class="mx-auto max-w-6xl px-6 pb-24 sm:px-12 lg:px-24">
    <div class="mb-12 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Blog</p>
        <h2 class="mt-3 text-3xl font-heading text-white sm:text-4xl">Derniers articles</h2>
      </div>
      <Button href="/blog" variant="ghost" size="sm">Lire le blog</Button>
    </div>
    <div class="grid gap-6 lg:grid-cols-3">
      {latestPosts.map((post) => (
        <Card interactive padding="lg" class="group flex h-full flex-col justify-between">
          <div>
            <Badge variant="accent">{post.data.category}</Badge>
            <h3 class="mt-4 text-2xl font-semibold text-white">{post.data.title}</h3>
            <p class="mt-4 text-sm text-slate-300">{post.data.description}</p>
          </div>
          <div class="mt-6 flex items-center justify-between text-sm text-slate-300">
            <span>{new Date(post.data.publishedAt).toLocaleDateString('fr-FR')}</span>
            <Button href={`/blog/${post.slug}`} variant="ghost" size="sm" class="group-hover:text-cyanAura">
              Lire l’article
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </section>

  <section id="contact" class="relative overflow-hidden border-t border-white/5 bg-white/5 py-24">
    <div class="absolute inset-0 -z-10 bg-hero opacity-40" />
    <div class="mx-auto max-w-4xl px-6 sm:px-12 lg:px-24">
      <h2 class="text-3xl font-heading text-white sm:text-4xl">Parlons de votre prochain projet</h2>
      <p class="mt-4 text-base text-slate-300">
        Nous bâtissons des produits digitaux durables, scalables et mesurables. Laissez-nous un message pour décrocher un audit gratuit.
      </p>
      <form class="mt-10 grid gap-6 md:grid-cols-2">
        <Input placeholder="Nom" />
        <Input placeholder="Email professionnel" type="email" />
        <Input class="md:col-span-2" placeholder="Société" />
        <Textarea class="md:col-span-2 min-h-[160px]" placeholder="Parlez-nous de votre projet" />
        <Button class="md:col-span-2 justify-center" type="submit">
          Envoyer ma demande
        </Button>
      </form>
    </div>
  </section>
</BaseLayout>
