---
import BaseLayout from '@layouts/BaseLayout.astro';
import AdminApp from '../../components/admin/AdminApp';
---

<BaseLayout title="Head Center — Console Admin" description="Gérez vos articles et projets via Supabase.">
  <section class="mx-auto max-w-6xl px-6 py-24 sm:px-12">
    <div class="mb-12 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Administration</p>
      <h1 class="mt-4 text-4xl font-heading text-white">Gestion centralisée du contenu</h1>
      <p class="mt-4 text-base text-slate-300">
        Connectez-vous avec votre compte Supabase pour créer, éditer et publier des articles et des projets.
      </p>
    </div>
    <div class="rounded-3xl border border-white/5 bg-white/5 p-8 shadow-card">
      <AdminApp client:load />
    </div>
  </section>
</BaseLayout>
