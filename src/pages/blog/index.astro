---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogView from '@components/blog/BlogView';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1));
const hydratedPosts = posts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  publishedAt: post.data.publishedAt,
  tags: post.data.tags,
  author: post.data.author
}));
---

<BaseLayout title="Head Center — Blog" description="Articles sur le développement web moderne, le DevOps et la stratégie produit.">
  <section class="mx-auto max-w-5xl px-6 py-24 sm:px-12">
    <div class="mb-16 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyanAura">Blog</p>
      <h1 class="mt-4 text-4xl font-heading text-white">Inspiration et retours d’expérience</h1>
      <p class="mt-4 text-base text-slate-300">
        Un condensé des meilleures pratiques en Astro, React, Supabase, AWS et DevOps pour bâtir des produits performants.
      </p>
    </div>
    <BlogView client:load posts={hydratedPosts} />
  </section>
</BaseLayout>
