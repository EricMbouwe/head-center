---
import '../styles/global.css';
const { title = 'Head Center – Agence Web', description = 'Solutions web modernes avec Astro, React, TypeScript et TailwindCSS.' } = Astro.props;
---

<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-midnight text-slate-100 font-sans min-h-screen">
    <main class="relative overflow-hidden">
      <slot />
    </main>
  </body>
</html>
